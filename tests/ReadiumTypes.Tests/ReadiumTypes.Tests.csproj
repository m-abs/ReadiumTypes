<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mabs.ReadiumTypes.Tests</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="StyleCop.Analyzers" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ReadiumTypes/ReadiumTypes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../specs/webpub-manifest/examples/Flatland/manifest.json" Link="fixtures/flatland-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../specs/webpub-manifest/examples/MobyDick/manifest.json" Link="fixtures/mobydick-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../specs/webpub-manifest/examples/CarrotAndPepper/manifest.json" Link="fixtures/carrotandpepper-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
